{
  "version": "3.0.0",
  "note": "Silent Future design system (F3.7). The four-layer ink wash is retired as the primary expression; the light is now an optical bead. `levels` keeps its five keys because crates/light-core binds its palette to them - appearance only, business thresholds unchanged. Rollback: git revert to 2.0.0.",
  "canvas": {
    "logicalSizePx": 132,
    "maxDevicePixelRatio": 2,
    "background": "transparent"
  },
  "colors": {
    "night": "#0A0F16",
    "ink": "#101821",
    "elevated": "#18212A",
    "quiet": "#35404A",
    "ivory": "#F1E9DC",
    "secondary": "#B9B6B3",
    "muted": "#87939D",
    "inkBlue": "#526579",
    "inkGreen": "#586761",
    "agedMetal": "#A6937C",
    "warmLight": "#F6D8C0",
    "warning": "#D9AA6E",
    "error": "#D78186",
    "ok": "#AFC1A8",
    "mist": "#77747A",
    "coral": "#F1A99D",
    "growing": "#DF7970",
    "crimson": "#BC4054",
    "deep": "#7D2038",
    "hot": "#F6D8C0",
    "bloomDeep": "#3A1A18",
    "bloomWarm": "#8A4640",
    "haloDormant": "#8A7D83",
    "haloFaint": "#F2B3A7",
    "haloGrowing": "#E38A80",
    "haloBlazing": "#DE7376",
    "haloDeep": "#E28980",
    "faintCore": "#D68B83"
  },
  "levels": {
    "DORMANT": {
      "coreColor": "mist",
      "glowColor": "haloDormant",
      "coreRadiusPx": 5.0,
      "bloomRadiusPx": 13,
      "bloomAlpha": 0.3,
      "haloRadiusPx": 20,
      "haloAlpha": 0.12,
      "glowAlpha": 0.3,
      "breathPeriodMs": 12000,
      "breathAmplitude": 0.06,
      "luminance": 0.55,
      "label": "沉睡",
      "title": "寻光者"
    },
    "FAINT": {
      "coreColor": "faintCore",
      "glowColor": "haloFaint",
      "coreRadiusPx": 5.4,
      "bloomRadiusPx": 16,
      "bloomAlpha": 0.34,
      "haloRadiusPx": 26,
      "haloAlpha": 0.2,
      "glowAlpha": 0.55,
      "breathPeriodMs": 11000,
      "breathAmplitude": 0.06,
      "luminance": 0.72,
      "label": "微明",
      "title": "初明者"
    },
    "GROWING": {
      "coreColor": "growing",
      "glowColor": "haloGrowing",
      "coreRadiusPx": 5.8,
      "bloomRadiusPx": 19,
      "bloomAlpha": 0.38,
      "haloRadiusPx": 32,
      "haloAlpha": 0.26,
      "glowAlpha": 0.58,
      "breathPeriodMs": 10000,
      "breathAmplitude": 0.06,
      "luminance": 0.8,
      "label": "生长",
      "title": "启迪者"
    },
    "BLAZING": {
      "coreColor": "crimson",
      "glowColor": "haloBlazing",
      "coreRadiusPx": 6.2,
      "bloomRadiusPx": 22,
      "bloomAlpha": 0.42,
      "haloRadiusPx": 38,
      "haloAlpha": 0.3,
      "glowAlpha": 0.62,
      "breathPeriodMs": 9500,
      "breathAmplitude": 0.06,
      "luminance": 0.86,
      "label": "炽热",
      "title": "探索者"
    },
    "DEEP": {
      "coreColor": "deep",
      "glowColor": "haloDeep",
      "coreRadiusPx": 6.8,
      "bloomRadiusPx": 25,
      "bloomAlpha": 0.46,
      "haloRadiusPx": 42,
      "haloAlpha": 0.34,
      "glowAlpha": 0.64,
      "breathPeriodMs": 9500,
      "breathAmplitude": 0.06,
      "luminance": 0.9,
      "label": "深红",
      "title": "拓界者"
    }
  },
  "inkLight": {
    "note": "The four layers. L1 core, L2 bloom, L3 veil, L4 pulse. Geometry is in logical px; the renderer scales by devicePixelRatio.",
    "core": {
      "edgeHarmonics": 3,
      "edgeAmount": 0.075,
      "samples": 64,
      "innerLightAlpha": 0.46,
      "innerLightRadiusFactor": 0.24,
      "edgeBlurPx": 0.6
    },
    "bloom": {
      "note": "Ink eaten into the paper: several offset wet touches, blurred at the rim. A flat fill reads as a sticker; ink must bleed.",
      "touches": 7,
      "offsetFactor": 0.38,
      "radiusJitter": 0.34,
      "alphaPerTouch": 0.1,
      "edgeAmount": 0.3,
      "blurRadiusFactor": 0.42,
      "nearCoreBoost": 0.55,
      "nearCoreAlpha": 0.12
    },
    "veil": {
      "note": "The translation from object to light. No hard neon rim, no white blowout.",
      "innerStop": 0.0,
      "midStop": 0.42,
      "outerStop": 1.0,
      "midAlphaFactor": 0.42,
      "outerAlphaFactor": 0.1
    },
    "pulse": {
      "note": "Breathing modulates the bloom and veil only. The core stays steady: a light source does not dim, the air around it moves.",
      "veilOpacityMin": 0.86,
      "veilOpacityMax": 1.0,
      "coreScale": 1.0,
      "amplitudeMax": 0.06
    }
  },
  "motion": {
    "float": {
      "amplitudePx": 1.4,
      "periodMs": 16000
    },
    "ignitionFlash": {
      "note": "First time a model family is verified. A thin ring expands and fades.",
      "durationMs": 1400,
      "ringStartRadiusFactor": 0.55,
      "ringEndRadiusFactor": 2.6,
      "ringAlpha": 0.62,
      "coreBoostAlpha": 0.3,
      "playsOnce": true
    },
    "newFamilyFlash": {
      "note": "A further family appears. A softer halo pulse, colour moves to the next level.",
      "durationMs": 1600,
      "haloBoost": 0.22,
      "coreBoostAlpha": 0.35,
      "levelTransitionMs": 1600
    },
    "farPulse": {
      "note": "Someone far away lights up. A ring expands outward and dissolves.",
      "durationMs": 2000,
      "startRadiusFactor": 1.0,
      "endRadiusFactor": 2.2,
      "alpha": 0.42,
      "maxPerMinute": 2
    },
    "reduceMotion": {
      "note": "Honours the system preference and the in-app quiet mode.",
      "staticFrame": true,
      "keepLevelColor": true,
      "disablesFloat": true,
      "disablesBreath": true,
      "disablesRings": true
    },
    "page": {
      "enterMs": 300,
      "easing": "cubic-bezier(.22,.61,.36,1)"
    },
    "transfer": {
      "note": "The ceremony of passing light. Every phase is driven by server state, never by a timer.",
      "startPulse": {
        "durationMs": 900,
        "scale": 1.05,
        "alpha": 0.88
      },
      "waitingRing": {
        "periodMs": 12000,
        "radiusFactor": 1.5,
        "alpha": 0.18,
        "lineWidthPx": 0.8
      },
      "receiveRing": {
        "durationMs": 1400,
        "startRadiusFactor": 1.0,
        "endRadiusFactor": 1.9,
        "alpha": 0.34
      },
      "mote": {
        "note": "One small red mote leaves the helper's core and travels a soft arc.",
        "radiusPx": 2.2,
        "travelMs": 2400,
        "arcHeightPx": 22,
        "trailSamples": 14,
        "trailAlpha": 0.26,
        "arrivalRingAlpha": 0.4
      },
      "activationFlash": {
        "durationMs": 1900,
        "coreBoost": 0.35,
        "ringAlpha": 0.5
      },
      "echoWave": {
        "durationMs": 1900,
        "startRadiusFactor": 1.0,
        "endRadiusFactor": 2.2,
        "alpha": 0.36
      },
      "failureDim": {
        "opacityFactor": 0.6,
        "durationMs": 700
      }
    },
    "ui": {
      "microMs": 120,
      "stateMs": 200,
      "pageMs": 240,
      "easing": [
        0.2,
        0.8,
        0.2,
        1
      ]
    },
    "breath": {
      "periodMs": 6400,
      "amplitude": 0.035,
      "appliesTo": "veil"
    }
  },
  "rings": {
    "lineWidthPx": 0.9,
    "minAlpha": 0.02,
    "fadePower": 1.9
  },
  "panel": {
    "width": 720,
    "height": 900,
    "cornerRadiusPx": 16,
    "titleLetterSpacing": "0.14em",
    "safeMarginPx": 48,
    "contentMaxWidthPx": 560
  },
  "layout": {
    "spacingBasePx": 8,
    "spacingScalePx": [
      8,
      16,
      24,
      32,
      48,
      64
    ],
    "minReadableTextPx": 13,
    "minHitBoxPx": 44
  },
  "type": {
    "family": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', system-ui, sans-serif",
    "numeric": "'SF Mono', ui-monospace, Menlo, monospace",
    "scale": {
      "display": 34,
      "title": 22,
      "lead": 15,
      "body": 13,
      "small": 11.5,
      "micro": 10
    },
    "lineHeight": {
      "display": 1.15,
      "title": 1.3,
      "body": 1.6,
      "small": 1.45
    },
    "tracking": {
      "display": -0.01,
      "title": 0,
      "body": 0,
      "micro": 0.06
    }
  },
  "surfaces": {
    "note": "The panel is opaque and provides its own paper. The desktop light point does not: it composites over the user's wallpaper.",
    "canvas": "night",
    "paper": "ink",
    "elevated": "elevated",
    "rule": "quiet",
    "textPrimary": "ivory",
    "textSecondary": "secondary",
    "textMuted": "muted",
    "accent": "coral",
    "danger": "error",
    "warn": "warning",
    "good": "ok"
  },
  "paper": {
    "note": "A faint fibre grain and a slow diagonal fall of light. Only inside the panel, never on the desktop overlay.",
    "grainOpacity": 0.028,
    "grainScalePx": 1.6,
    "lightFallAlpha": 0.05
  },
  "theme": {
    "dark": {
      "page": "#0A0B0D",
      "surface": "#111316",
      "raised": "#171A1E",
      "overlay": "#1D2126",
      "border": "#FFFFFF14",
      "borderStrong": "#FFFFFF26",
      "text": "#E8EBEF",
      "textSecondary": "#9BA3AD",
      "textTertiary": "#666E78",
      "signal": "#7ED6C0",
      "warm": "#E8A87C",
      "danger": "#E0686A",
      "warn": "#D6A86A"
    },
    "light": {
      "page": "#F7F7F5",
      "surface": "#FFFFFF",
      "raised": "#FFFFFF",
      "overlay": "#FFFFFF",
      "border": "#00000012",
      "borderStrong": "#00000022",
      "text": "#16181B",
      "textSecondary": "#5A6169",
      "textTertiary": "#8A9199",
      "signal": "#1F8F78",
      "warm": "#B4652E",
      "danger": "#B03A3C",
      "warn": "#8A6420"
    }
  },
  "space": {
    "base": 4,
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ],
    "optical": {
      "hairlinePx": 1,
      "iconStrokePx": 1.5,
      "radiusSm": 6,
      "radiusMd": 10,
      "radiusLg": 16
    }
  },
  "grid": {
    "marginPx": 32,
    "contentMaxPx": 560,
    "columns": 12,
    "gutterPx": 16
  },
  "bead": {
    "note": "Luminous Matter. A bead, not a glow: limb darkening, a rim that catches light, one specular, and a contact shadow. The shadow is what keeps it visible on a light desktop, where additive light cannot exist.",
    "bodyFraction": 0.4,
    "veilFactor": {
      "24": 0.0,
      "32": 0.34,
      "44": 0.36,
      "64": 0.34,
      "96": 0.32
    },
    "limbDarkening": 0.55,
    "rimAlpha": {
      "24": 0.75,
      "32": 0.68,
      "44": 0.62,
      "64": 0.55,
      "96": 0.5
    },
    "rimWidth": 0.14,
    "specularAlpha": 0.85,
    "specularRadius": 0.26,
    "shadowAlpha": {
      "24": 0.3,
      "32": 0.3,
      "44": 0.28,
      "64": 0.26,
      "96": 0.24
    },
    "shadowOffset": 0.3,
    "shadowBlur": 0.34
  },
  "light": {
    "sizes": {
      "24": {
        "beadPx": 10,
        "windowPx": 24
      },
      "32": {
        "beadPx": 13,
        "windowPx": 32
      },
      "44": {
        "beadPx": 17,
        "windowPx": 44
      },
      "64": {
        "beadPx": 24,
        "windowPx": 64
      },
      "96": {
        "beadPx": 34,
        "windowPx": 96
      }
    },
    "anatomy": {
      "coreVisualDiameterPx": [
        10,
        34
      ],
      "targetMinimumHitBoxPx": 44,
      "breathScaleMaximum": 1.035
    }
  }
}
