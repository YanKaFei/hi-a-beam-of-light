.stage { min-height: 100vh; display: flex; flex-direction: column; align-items: center; }
.brand { font-size: 10px; letter-spacing: 5px; color: var(--ink-3); padding: 14px 0 0; }
.light-wrap { position: relative; width: 100%; height: 40vh; max-height: 340px; display: flex; align-items: center; justify-content: center; }
.light { width: 100%; height: 100%; position: relative; z-index: 2; }
.align-base { position: absolute; left: 0; top: 0; z-index: 1; }
.light-base { position: absolute; width: 118%; height: 118%; left: -9%; top: -9%; z-index: 1; }

.call { margin-top: -12vh; display: flex; flex-direction: column; align-items: center; padding: 10px 24px; }
.call-title { font-size: 30px; font-weight: 500; letter-spacing: 2px; color: var(--ink); }
.call-hint { margin-top: 8px; font-size: 14px; color: var(--ink-2); letter-spacing: 0; }

.status { margin-top: 22px; display: flex; flex-direction: column; align-items: center; }
.status-text { font-size: 15px; color: var(--ink); }
.status-sub { margin-top: 6px; font-size: 14px; color: var(--ink-2); }

.narrative { margin-top: 18px; width: 78%; min-height: 66px; }
.line { font-size: 12.5px; line-height: 1.9; color: var(--ink-2); opacity: 0; animation: rise 320ms ease-out forwards; }
.line.found { color: var(--terracotta); }
.line.error { color: var(--terracotta); }
@keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: .92; transform: none; } }
.cancel { margin-top: 10px; font-size: 12px; color: var(--ink-3); text-decoration: underline; }

.actions { margin-top: 24px; }
.act { font-size: 13.5px; color: var(--terracotta); padding: 12px 20px; border: 1px solid var(--rule); border-radius: 999px; }
.act.quiet { color: var(--ink-2); }

.detail { margin-top: 20px; width: 80%; }
.drow { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--rule); }
.dk { font-size: 12px; color: var(--ink-2); }
.dv { font-size: 12.5px; color: var(--ink); }
.note { margin-top: 12px; font-size: 11.5px; line-height: 1.8; color: var(--ink-3); }

.more { margin-top: auto; padding: 26px 0 calc(26px + env(safe-area-inset-bottom)); display: flex; align-items: center; }
.more-link { font-size: 12.5px; color: var(--ink-2); padding: 12px 14px; }
.more-dot { color: var(--ink-3); font-size: 12px; }

.intro { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #FFFFFF; z-index: 999; display: flex;
  align-items: center; justify-content: center; transition: opacity 500ms ease-out; }
.intro.fading { opacity: 0; }
.intro-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.intro-text { position: absolute; left: 0; right: 0; text-align: center; opacity: 0;
  transition: opacity 600ms ease-out, transform 900ms ease-out; }
.intro-text.in { opacity: 1; }
.manifesto { font-size: 26px; line-height: 1.45; letter-spacing: 3px; font-weight: 500; color: var(--ink);
  padding: 0 34px; transform: translateY(8px); }
.manifesto.in { transform: none; }
.hello { font-size: 24px; letter-spacing: 1.5px; color: var(--ink); font-weight: 400; transform: translateY(6px); }
.hello.in { transform: none; }
.intro-skip { position: absolute; left: 12px; top: 8px; min-width: 44px; min-height: 44px;
  display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--ink-2); }

/* Opening 02: light passes to another light; the donor stays lit. */
.opening-copy { position: absolute; top: 57%; left: 20px; right: 20px; text-align: center; white-space: pre-line; font-size: 23px; font-weight: 400; letter-spacing: 1px; line-height: 1.85; color: #3a3c34; }
.opening-copy.welcome { font-size: 28px; letter-spacing: 1.5px; }
.opening-brand { position: absolute; bottom: calc(35px + env(safe-area-inset-bottom)); font-size: 10px; letter-spacing: 4px; color: var(--ink-2); opacity: .6; }
.intro { background: #faf9f6; }
